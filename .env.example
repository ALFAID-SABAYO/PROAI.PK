# Backend environment variables — copy to backend/.env or project root .env
# NEVER commit the real .env file.

# Neon pooled connection string (use -pooler endpoint, NOT direct)
DATABASE_URL=postgresql+psycopg2://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# JWT secret — REQUIRED in production (min 32 random characters)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# development | production
ENVIRONMENT=development

# CORS origins (comma-separated, no wildcard in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set false in production to disable /docs and /openapi.json
# OPENAPI_ENABLED=false

# Max CSV upload size in bytes (default 50 MB)
# MAX_CSV_UPLOAD_BYTES=52428800

# Optional: limit seed rows for testing (0 = all rows)
SEED_LIMIT=0
