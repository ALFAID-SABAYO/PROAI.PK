# Copy to .env when using docker-compose.neon.yml (Neon cloud DB)
# For default docker-compose.yml, you do NOT need a .env file — local Postgres is included.

DATABASE_URL=postgresql+psycopg2://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
SECRET_KEY=your-super-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker backend tuning
SEED_ON_START=true
SEED_LIMIT=5000
