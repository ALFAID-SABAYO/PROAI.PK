# Backend environment variables — copy to project root .env

# Neon pooled connection string (use -pooler endpoint, NOT direct)
DATABASE_URL=postgresql+psycopg2://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# JWT secret — change in production
SECRET_KEY=your-super-secret-key-change-in-production

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: limit seed rows for testing (0 = all rows)
SEED_LIMIT=0
